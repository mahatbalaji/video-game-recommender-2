# Game Quest Configuration
# This is an example file. Copy to .env and fill in your values if needed.

# Hugging Face API Key (optional - for higher rate limits)
# Get your free API key at: https://huggingface.co/settings/tokens
HUGGING_FACE_API_KEY=your_api_key_here

# LLM Model Configuration (optional - customize the model)
LLM_MODEL_PRIMARY=mistralai/Mistral-7B-Instruct-v0.1
LLM_MODEL_BACKUP=google/flan-t5-large

# API Configuration
LLM_API_TEMPERATURE=0.7
LLM_API_MAX_TOKENS=500
LLM_API_TOP_P=0.95

# Optional: Use a different LLM provider
# Supported providers: huggingface, openai, cohere, anthropic
LLM_PROVIDER=huggingface
